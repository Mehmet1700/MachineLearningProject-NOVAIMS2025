{
  "regex_rules": [
    { "pattern": "^(a|b|c|e|s|v|m|g|x|gl|gle|gls|glc|gla|glb|sl|cls?)\\s*clas$", "replace": "\\1-Class" },
    { "pattern": "^(a|b|c|e|s|v|m|g|x)[\\s\\-_]?clas?$", "replace": "\\1-Class" },
    { "pattern": "^(gl|gle|gls|glc|gla|glb)[\\s\\-_]?clas?$", "replace": "\\1-Class" },
    { "pattern": "^clc[\\s\\-_]?class$", "replace": "CLC-Class" },
    { "pattern": "^cl[\\s\\-_]?class$", "replace": "CL-Class" },
    { "pattern": "^cls[\\s\\-_]?class$", "replace": "CLS-Class" },
    { "pattern": "^slk[\\s\\-_]?class$", "replace": "SLK-Class" },
    { "pattern": "^sl[\\s\\-_]?class$", "replace": "SL-Class" },
    { "pattern": "^clk[\\s\\-_]?class$", "replace": "CLK-Class" },

    
    { "pattern": "^([1-8])\\s*series?$", "replace": "\\1 Series" },
    { "pattern": "^a([1-8])$", "replace": "A\\1" },
    { "pattern": "^q(2|3|5|7|8)$", "replace": "Q\\1" },
    { "pattern": "^s(3|4|5|8)$", "replace": "S\\1" },
    { "pattern": "^rs(3|4|5|6)$", "replace": "RS\\1" },
    { "pattern": "^x([1-7])$", "replace": "X\\1" },
    { "pattern": "^m(2|3|4|5|6)$", "replace": "M\\1" },
    { "pattern": "^z(3|4)$", "replace": "Z\\1" },

  
    { "pattern": "^(polo|pol)$", "replace": "Polo" },
    { "pattern": "^golf[s]?$", "replace": "Golf" },
    { "pattern": "^golfs?v$", "replace": "Golf SV" },
    { "pattern": "^passa?t$", "replace": "Passat" },
    { "pattern": "^passa$", "replace": "Passat" },
    { "pattern": "^tiguan$", "replace": "Tiguan" },
    { "pattern": "^crosslandx$", "replace": "Crossland X" },
    { "pattern": "^grandlandx$", "replace": "Grandland X" },
    { "pattern": "^mokkax$", "replace": "Mokka X" },
    { "pattern": "^caddymaxi$", "replace": "Caddy Maxi" },
    { "pattern": "^caddylife$", "replace": "Caddy Life" },
    { "pattern": "^cmax$", "replace": "C-MAX" },
    { "pattern": "^smax$", "replace": "S-MAX" },
    { "pattern": "^ka\\+?$", "replace": "Ka+" },
    { "pattern": "^(fiest|fiesta)$", "replace": "Fiesta" },
    { "pattern": "^(focu|focus)$", "replace": "Focus" },
    { "pattern": "^(auris|auri)$", "replace": "Auris" },
    { "pattern": "^(yaris|yari)$", "replace": "Yaris" },
    { "pattern": "^(aygo|ayg)$", "replace": "Aygo" },
    { "pattern": "^corolla$", "replace": "Corolla" },
    { "pattern": "^prius$", "replace": "Prius" },
    { "pattern": "^rav4$", "replace": "RAV4" },
    { "pattern": "^verso$", "replace": "Verso" },
    { "pattern": "^tucson$", "replace": "Tucson" },
    { "pattern": "^kona$", "replace": "Kona" },
    { "pattern": "^ioniq$", "replace": "Ioniq" },
    { "pattern": "^octavia$", "replace": "Octavia" },
    { "pattern": "^superb$", "replace": "Superb" },
    { "pattern": "^scala$", "replace": "Scala" },
    { "pattern": "^karoq$", "replace": "Karoq" },
    { "pattern": "^kamiq$", "replace": "Kamiq" },
    { "pattern": "^(insignia|insigni)$", "replace": "Insignia" },
    { "pattern": "^(vivaro|viv)$", "replace": "Vivaro" },
    { "pattern": "^amarok$", "replace": "Amarok" },
    { "pattern": "^arteon$", "replace": "Arteon" },
    { "pattern": "^touareg$", "replace": "Touareg" },
    { "pattern": "^(sharan)$", "replace": "Sharan" },
    { "pattern": "^(yeti)$", "replace": "Yeti" },

  
    { "pattern": "^tiguanallspac$", "replace": "Tiguan Allspace" },
    { "pattern": "^grandc-ma$", "replace": "Grand C-Max" },
    { "pattern": "^yetioutdoo$", "replace": "Yeti Outdoor" },
    { "pattern": "^yeti\\s*outdoor$", "replace": "Yeti Outdoor" },
    { "pattern": "^tiguan\\s*allspace$", "replace": "Tiguan Allspace" },
    { "pattern": "^grandland\\s*x$", "replace": "Grandland X" },
    { "pattern": "^crossland\\s*x$", "replace": "Crossland X" },
    { "pattern": "^caddy\\s*maxi$", "replace": "Caddy Maxi" },
    { "pattern": "^caddy\\s*life$", "replace": "Caddy Life" },
    { "pattern": "^mokka\\s*x$", "replace": "Mokka X" }
  ]
}
